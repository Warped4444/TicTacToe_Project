<Window x:Class="TicTacToe_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe_1"
        mc:Ignorable="d"
        Title="TicTacToe App" Height="500" Width="500">







    <StackPanel>
        <Label x:Name="StatusLable"
               Content="Player X's turn"
               FontSize="22"
               FontFamily="Calibri"
               HorizontalAlignment="Center" 
               Margin="10"/>
        <UniformGrid x:Name="GameGrid" Rows="3 " Columns="3" Height="400">

            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>

            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>

            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>
            <local:Button Click="Button_Click"/>

        </UniformGrid>

    </StackPanel>
    
</Window>
